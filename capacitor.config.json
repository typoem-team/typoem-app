{
  "appId": "com.typoem.app",
  "appName": "Typoem",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#ffffff"
  },
  "backgroundColor": "#ffffff",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#ffffff",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#ffffff"
    }
  }
}
